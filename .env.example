APP_NAME=Community Service
API_V1_PREFIX=/api/v1

DATABASE_URL=
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=community_db
MYSQL_USER=community
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password
API_PORT=8000

# Must be the same signing secret and issuer configured in identity-service.
JWT_SECRET=replace-with-the-shared-identity-service-signing-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=identity-service
